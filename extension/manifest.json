{
  "manifest_version": 3,
  "name": "StreamFlow Sync for Netflix",
  "version": "0.1.0",
  "description": "Lets a StreamFlow watch party observe and control Netflix playback on this device.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://*.netflix.com/*",
    "https://streamflow.stonetech.in/*",
    "https://streamflowbyvv.lovable.app/*",
    "https://*.lovable.app/*",
    "http://localhost:8080/*"
  ],
  "background": { "service_worker": "background/worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "StreamFlow Sync" },
  "content_scripts": [
    {
      "matches": ["https://*.netflix.com/*"],
      "js": ["content/netflix.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://streamflow.stonetech.in/*",
        "https://streamflowbyvv.lovable.app/*",
        "https://*.lovable.app/*",
        "http://localhost:8080/*"
      ],
      "js": ["content/streamflow.js"],
      "run_at": "document_start"
    }
  ]
}
